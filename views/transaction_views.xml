<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ats_share_transaction_tree" model="ir.ui.view">
        <field name="name">ats.share.transaction.tree</field>
        <field name="model">ats.share.transaction</field>
        <field name="arch" type="xml">
            <tree string="Transactions">
                <field name="name"/>
                <field name="shareholder_id"/>
                <field name="recipient_id"/>
                <field name="transaction_type"/>
                <field name="correction_direction"/>
                <field name="quantity"/>
                <field name="running_total"/>
                <field name="transaction_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_ats_share_transaction_form" model="ir.ui.view">
        <field name="name">ats.share.transaction.form</field>
        <field name="model">ats.share.transaction</field>
        <field name="arch" type="xml">
            <form string="Transaction">

                <header>
                    <button name="action_complete"
                            string="Complete"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_reverse"
                            string="Reverse Transaction"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'completed' or reversal_transaction_id"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state != 'draft'"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,completed,cancelled"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"
                                   readonly="state == 'completed'"/>

                            <field name="shareholder_id"
                                   readonly="state == 'completed'"/>

                            <field name="recipient_id"
                                   readonly="state == 'completed'"/>

                            <field name="transaction_type"
                                   readonly="state == 'completed'"/>

                            <field name="correction_direction"
                                   invisible="transaction_type != 'correction'"
                                   readonly="state == 'completed'"/>
                        </group>

                        <group>
                            <field name="quantity"
                                   readonly="state == 'completed'"/>

                            <field name="running_total"
                                   readonly="1"/>

                            <field name="transaction_date"
                                   readonly="state == 'completed'"/>

                            <field name="state"
                                   readonly="1"/>
                        </group>
                    </group>

                    <group string="Reversal">
                        <field name="reversed_transaction_id"
                               readonly="1"/>

                        <field name="reversal_transaction_id"
                               readonly="1"/>
                    </group>

                    <group string="Notes">
                        <field name="notes"
                               readonly="state == 'completed'"/>
                    </group>
                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <record id="view_ats_share_transaction_search" model="ir.ui.view">
        <field name="name">ats.share.transaction.search</field>
        <field name="model">ats.share.transaction</field>
        <field name="arch" type="xml">
            <search string="Transactions">

                <field name="name"/>
                <field name="shareholder_id"/>
                <field name="recipient_id"/>
                <field name="transaction_type"/>
                <field name="state"/>

                <filter name="draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>

                <filter name="completed"
                        string="Completed"
                        domain="[('state', '=', 'completed')]"/>

                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <filter name="purchases"
                        string="Purchases"
                        domain="[('transaction_type', '=', 'purchase')]"/>

                <filter name="transfers"
                        string="Transfers"
                        domain="[('transaction_type', '=', 'transfer')]"/>

                <filter name="corrections"
                        string="Corrections"
                        domain="[('transaction_type', '=', 'correction')]"/>

            </search>
        </field>
    </record>

    <record id="action_ats_share_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">ats.share.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ats_share_transaction_search"/>
    </record>

    <menuitem
        id="menu_ats_share_transaction"
        name="Transactions"
        parent="menu_ats_share_management_root"
        action="action_ats_share_transaction"
        sequence="30"
    />

</odoo>