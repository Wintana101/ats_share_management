<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ats_shareholder_tree"
            model="ir.ui.view">

        <field name="name">ats.shareholder.tree</field>
        <field name="model">ats.shareholder</field>

        <field name="groups_id"
               eval="[
                   (4, ref('ats_share_management.group_sms_administrator')),
                   (4, ref('ats_share_management.group_sms_officer'))
               ]"/>

        <field name="arch" type="xml">
            <tree string="Shareholders"
                  create="1"
                  edit="1">

                <field name="shareholder_code"/>
                <field name="name"/>
                <field name="registration_number"/>
                <field name="shareholder_type"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="total_shares_owned"/>
                <field name="company_id"/>
                <field name="active"/>

            </tree>
        </field>

    </record>

    <record id="view_ats_shareholder_tree_viewer"
            model="ir.ui.view">

        <field name="name">ats.shareholder.tree.viewer</field>
        <field name="model">ats.shareholder</field>

        <field name="groups_id"
               eval="[
                   (4, ref('ats_share_management.group_sms_viewer'))
               ]"/>

        <field name="arch" type="xml">
            <tree string="Shareholders"
                  create="0"
                  edit="0"
                  delete="0">

                <field name="shareholder_code"/>
                <field name="name"/>
                <field name="registration_number"/>
                <field name="shareholder_type"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="total_shares_owned"/>
                <field name="company_id"/>
                <field name="active"/>

            </tree>
        </field>

    </record>

    <record id="view_ats_shareholder_form"
            model="ir.ui.view">

        <field name="name">ats.shareholder.form</field>
        <field name="model">ats.shareholder</field>

        <field name="groups_id"
               eval="[
                   (4, ref('ats_share_management.group_sms_administrator')),
                   (4, ref('ats_share_management.group_sms_officer'))
               ]"/>

        <field name="arch" type="xml">
            <form string="Shareholder"
                  create="1"
                  edit="1">

                <header>

                    <button name="472"
                            string="Print Certificate"
                            type="action"
                            class="oe_highlight"
                            icon="fa-print"/>

                    <button name="474"
                            string="Print Shareholder Register"
                            type="action"
                            class="oe_highlight"
                            icon="fa-print"/>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_transactions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange">

                            <field name="transaction_count"
                                   widget="statinfo"
                                   string="Transactions"/>

                        </button>

                        <button name="action_view_shares"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pie-chart">

                            <field name="share_count"
                                   widget="statinfo"
                                   string="Shares"/>

                        </button>

                    </div>

                    <group>

                        <group>

                            <field name="shareholder_code"
                                   readonly="1"/>

                            <field name="name"/>

                            <field name="registration_number"/>

                            <field name="shareholder_type"/>

                        </group>

                        <group>

                            <field name="phone"/>

                            <field name="email"/>

                            <field name="company_id"/>

                            <field name="registration_date"/>

                            <field name="status"/>

                            <field name="active"/>

                        </group>

                    </group>

                    <group string="Personal Information">

                        <field name="date_of_birth"/>

                        <field name="gender"/>

                    </group>

                    <group string="Address">

                        <field name="address"/>

                    </group>

                    <group string="Bank Information">

                        <field name="bank_name"/>

                        <field name="bank_account"/>

                    </group>

                    <group string="Share Ownership">

                        <field name="total_shares_owned"
                               readonly="1"/>

                        <field name="wallet_balance"/>

                    </group>

                </sheet>

                <chatter/>

            </form>
        </field>

    </record>

    <record id="view_ats_shareholder_form_viewer"
            model="ir.ui.view">

        <field name="name">ats.shareholder.form.viewer</field>
        <field name="model">ats.shareholder</field>

        <field name="groups_id"
               eval="[
                   (4, ref('ats_share_management.group_sms_viewer'))
               ]"/>

        <field name="arch" type="xml">
            <form string="Shareholder"
                  create="0"
                  edit="0"
                  delete="0">

                <header>

                    <button name="472"
                            string="Print Certificate"
                            type="action"
                            class="oe_highlight"
                            icon="fa-print"/>

                    <button name="474"
                            string="Print Shareholder Register"
                            type="action"
                            class="oe_highlight"
                            icon="fa-print"/>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_transactions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange">

                            <field name="transaction_count"
                                   widget="statinfo"
                                   string="Transactions"/>

                        </button>

                        <button name="action_view_shares"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pie-chart">

                            <field name="share_count"
                                   widget="statinfo"
                                   string="Shares"/>

                        </button>

                    </div>

                    <group>

                        <group>

                            <field name="shareholder_code"
                                   readonly="1"/>

                            <field name="name"
                                   readonly="1"/>

                            <field name="registration_number"
                                   readonly="1"/>

                            <field name="shareholder_type"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="phone"
                                   readonly="1"/>

                            <field name="email"
                                   readonly="1"/>

                            <field name="company_id"
                                   readonly="1"/>

                            <field name="registration_date"
                                   readonly="1"/>

                            <field name="status"
                                   readonly="1"/>

                            <field name="active"
                                   readonly="1"/>

                        </group>

                    </group>

                    <group string="Personal Information">

                        <field name="date_of_birth"
                               readonly="1"/>

                        <field name="gender"
                               readonly="1"/>

                    </group>

                    <group string="Address">

                        <field name="address"
                               readonly="1"/>

                    </group>

                    <group string="Bank Information">

                        <field name="bank_name"
                               readonly="1"/>

                        <field name="bank_account"
                               readonly="1"/>

                    </group>

                    <group string="Share Ownership">

                        <field name="total_shares_owned"
                               readonly="1"/>

                        <field name="wallet_balance"
                               readonly="1"/>

                    </group>

                </sheet>

                <chatter/>

            </form>
        </field>

    </record>

    <record id="view_ats_shareholder_search"
            model="ir.ui.view">

        <field name="name">ats.shareholder.search</field>
        <field name="model">ats.shareholder</field>

        <field name="arch" type="xml">

            <search string="Shareholders">

                <field name="name"/>
                <field name="shareholder_code"/>
                <field name="registration_number"/>
                <field name="shareholder_type"/>
                <field name="company_id"/>

                <filter name="active"
                        string="Active"
                        domain="[('active', '=', True)]"/>

                <filter name="inactive"
                        string="Archived"
                        domain="[('active', '=', False)]"/>

                <group expand="0"
                       string="Group By">

                    <filter name="group_by_type"
                            string="Type"
                            context="{'group_by': 'shareholder_type'}"/>

                    <filter name="group_by_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"/>

                </group>

            </search>

        </field>

    </record>

    <record id="action_ats_shareholder"
            model="ir.actions.act_window">

        <field name="name">Shareholders</field>

        <field name="res_model">ats.shareholder</field>

        <field name="view_mode">tree,form</field>

        <field name="search_view_id"
               ref="view_ats_shareholder_search"/>

        <field name="help"
               type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first shareholder
            </p>

        </field>

    </record>

    <menuitem id="menu_ats_shareholders"
              name="Shareholders"
              parent="menu_ats_share_management_root"
              action="action_ats_shareholder"
              sequence="20"/>

</odoo>