<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_sms_administrator" model="res.groups">
        <field name="name">SMS Administrator</field>
        <field name="category_id"
               ref="base.module_category_hidden"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="group_sms_officer" model="res.groups">
        <field name="name">SMS Officer</field>
        <field name="category_id"
               ref="base.module_category_hidden"/>
    </record>
 
    <record id="group_sms_viewer" model="res.groups">
        <field name="name">SMS Viewer</field>
        <field name="category_id"
               ref="base.module_category_hidden"/>
    </record>

</odoo>